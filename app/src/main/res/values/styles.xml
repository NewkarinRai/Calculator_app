<resources>
    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:background">@drawable/button_round</item>
    </style>

    <style name="CalcButtonNumber" parent="CalcButtonBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#2E2E2E</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButtonBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#FF9500</item>
    </style>

    <style name="CalcButtonFunction" parent="CalcButtonBase">
        <item name="android:textColor">#000000</item>
        <item name="android:backgroundTint">#D4D4D2</item>
    </style>

    <style name="CalcButtonEquals" parent="CalcButtonBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#FF9500</item>
    </style>
</resources>